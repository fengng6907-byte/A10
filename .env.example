# mock or live. Live uses Twelve Data's XAU/USD candles.
MARKET_DATA_MODE=mock
TWELVE_DATA_API_KEY=
# Optional. The rule engine still works without an AI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_PATH=./data/gold-ai-copilot.db

# US equities. Moomoo is the primary provider; legacy STOCK_DATA_MODE remains supported.
STOCK_DATA_PROVIDER=moomoo
# Optional fallback: twelvedata, sample, or none. Sample fallback never emits live alerts.
STOCK_FALLBACK_PROVIDER=none
STOCK_DATA_MODE=sample
# Moomoo REST OAuth 2.1 + PKCE. The app dynamically registers a public client when
# MOOMOO_CLIENT_ID is empty. The callback must exactly match the registered URI.
MOOMOO_CLIENT_ID=
MOOMOO_REDIRECT_URI=http://localhost:3000/api/stocks/moomoo/oauth/callback
# Production requires a random 32-byte base64 key. Local development creates an
# ignored data/.moomoo-token-key file. OAuth tokens themselves are encrypted in SQLite.
MOOMOO_TOKEN_ENCRYPTION_KEY=
# Optional manual override. Leave blank to use the authenticated TSLA/MSFT
# WebSocket subscription probe. Set only with separately confirmed plan evidence.
MOOMOO_US_QUOTE_ACCESS=
MOOMOO_API_PER_SECOND=4
MOOMOO_QUOTE_CACHE_SECONDS=5
# Server worker only. Keep false for Vercel functions and never stream tokens to browsers.
MOOMOO_STREAMING_ENABLED=false
# Set to REALTIME, DELAYED or EOD only if your Twelve Data plan supports it.
# Otherwise live quotes are UNVERIFIED and cannot trigger alerts.
STOCK_QUOTE_ACCESS=
STOCK_MONITOR_MINUTES=5
STOCK_API_PER_MINUTE=8
STOCK_API_DAILY_BUDGET=800

# Phases 4–7 research. SEC requires an identifying application/contact User-Agent.
SEC_USER_AGENT=Gold AI Copilot research your-email@example.com
RESEARCH_USER_AGENT=Gold AI Copilot research feed reader
SEC_BATCH_SIZE=5
# JSON arrays: [{"ticker":"MSFT","url":"https://.../feed.xml","publisher":"Microsoft Investor Relations"}]
IR_FEEDS_JSON=[]
NEWS_FEEDS_JSON=[]
# Verified IPO facts only: [{"ticker":"ABCD","listingDate":"2026-01-15","ipoPrice":20,"sourceUrl":"https://...","publisher":"Exchange or issuer"}]
IPO_METADATA_JSON=[]
RESEARCH_OPENAI_MODEL=gpt-4.1-mini
# Optional cost accounting for the configured model. USD per one million tokens.
RESEARCH_INPUT_USD_PER_MILLION=0
RESEARCH_OUTPUT_USD_PER_MILLION=0
# Optional email delivery. Email is sent only after the user enables it in preferences.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=
# Protect future cron-compatible HTTP triggers. No schedules are activated in this repository.
CRON_SECRET=
